{
  "$comment": "Registered lifecycles (C-18). States and transitions are quoted from the phase documents; each guard is the formal Rule-expression rendering of the prose guard stated there, evaluated over facts computed at transition time. Cycles are designated explicitly (V-LC-04): a transition flagged \"cycle\" closes a legitimate loop; with those removed the transition graph must be acyclic.",
  "lifecycles": [
    {
      "id": "LC-FOUNDATION",
      "name": "Foundation Artifact Lifecycle",
      "source": "Phase 001 §10",
      "states": [
        "DRAFT",
        "PROPOSED",
        "RATIFIED",
        "CERTIFIED",
        "ADMISSIBLE",
        "DEPRECATED",
        "RETIRED",
        "SUPERSEDED",
        "REJECTED"
      ],
      "initial": "DRAFT",
      "terminals": [
        "RETIRED",
        "SUPERSEDED",
        "REJECTED"
      ],
      "transitions": [
        {
          "from": "DRAFT",
          "to": "PROPOSED",
          "guard": "derivationValid",
          "guardRule": "UCL-D03",
          "prose": "derivation chain stated and terminating at Tier-0"
        },
        {
          "from": "PROPOSED",
          "to": "RATIFIED",
          "guard": "quorumMet AND NOT openDispute",
          "guardRule": "UCL-G05",
          "prose": "quorum of the competent body; no open dispute"
        },
        {
          "from": "RATIFIED",
          "to": "CERTIFIED",
          "guard": "evidenceComplete AND acyclic AND NOT duplicate",
          "guardRule": "X-FR-02",
          "prose": "evidence complete; acyclicity proved; no duplicate concept"
        },
        {
          "from": "CERTIFIED",
          "to": "ADMISSIBLE"
        },
        {
          "from": "CERTIFIED",
          "to": "PROPOSED",
          "guard": "revocation = true",
          "guardRule": "X-FR-04",
          "prose": "certification revoked; the artifact returns for re-ratification",
          "cycle": true
        },
        {
          "from": "ADMISSIBLE",
          "to": "PROPOSED",
          "guard": "revocation = true",
          "guardRule": "X-FR-04",
          "cycle": true
        },
        {
          "from": "*",
          "to": "DEPRECATED",
          "guard": "successorStatus IN ['CERTIFIED', 'ADMISSIBLE']",
          "guardRule": "Phase001-§10",
          "prose": "successor certified and resolvable"
        },
        {
          "from": "*",
          "to": "RETIRED",
          "guard": "liveDependents = 0",
          "guardRule": "V-FR-09",
          "prose": "zero live dependents (hard gate)"
        },
        {
          "from": "*",
          "to": "SUPERSEDED",
          "guard": "exists(successor)",
          "guardRule": "V-FR-10"
        },
        {
          "from": "DRAFT",
          "to": "REJECTED",
          "guard": "exists(reason)",
          "guardRule": "Phase001-§10"
        },
        {
          "from": "PROPOSED",
          "to": "REJECTED",
          "guard": "exists(reason)",
          "guardRule": "Phase001-§10"
        },
        {
          "from": "RATIFIED",
          "to": "REJECTED",
          "guard": "exists(reason)",
          "guardRule": "Phase001-§10"
        }
      ]
    },
    {
